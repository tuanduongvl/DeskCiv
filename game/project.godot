config_version=5

[application]

config/name="DeskCiv"
run/main_scene="res://Main.tscn"
config/features=PackedStringArray("4.7", "C#", "GL Compatibility")
run/max_fps=30
boot_splash/show_image=false

[audio]

driver/output_latency=60

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/borderless=true
window/size/no_focus=true
window/vsync/vsync_mode=0
window/energy_saving/keep_screen_on=false
window/dpi/allow_hidpi=true

[dotnet]

project/assembly_name="DeskCiv"

[physics]

common/physics_ticks_per_second=1

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
anti_aliasing/quality/msaa_3d=1
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=2
